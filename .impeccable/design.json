      "html": "<article class=\"ds-card\"><img src=\"/products/mini-pizza.webp\" alt=\"Mini pizza\" loading=\"lazy\"><div class=\"ds-card-body\"><h3>Mini pizza</h3><div class=\"ds-card-foot\"><span class=\"ds-price\">R$ 2,95<small>/un</small></span></div></div></article>",
      "css": ".ds-card{display:flex;flex-direction:column;background:#fffdf9;border-radius:20px;box-shadow:inset 0 0 0 1px #e5dccd;overflow:hidden}.ds-card img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:20px 20px 0 0}.ds-card-body{display:grid;gap:8px;padding:16px 16px 20px;flex:1;align-content:start}.ds-card h3{margin:0;font:400 1.35rem/1.2 Gloock,Georgia,serif;color:#392317}.ds-card-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:8px}.ds-price{font:400 1.25rem/1.2 Gloock,Georgia,serif;color:#392317;white-space:nowrap;font-variant-numeric:tabular-nums}.ds-price small{font:400 13px/1 'Onest Variable',system-ui,sans-serif;color:#6b5c4c;margin-left:2px}.ds-card.ds-chosen{box-shadow:inset 0 0 0 2px #2f5440,0 6px 20px rgba(57,35,23,.08)}"
    },
    {
      "name": "Order Row",
      "kind": "card",
      "refersTo": "order-row",
      "description": "Encomenda na lista agrupada: horário, nome, itens e pílulas. Selecionada, ganha borda chocolate.",
      "html": "<button class=\"ds-row\"><span class=\"ds-row-when\"><strong>14:00</strong><span>Sáb</span></span><span class=\"ds-row-main\"><span class=\"ds-row-name\">Maria Silva</span><span class=\"ds-row-items\">1 kg Sonho de valsa</span></span></button>",
      "css": ".ds-row{display:grid;grid-template-columns:64px minmax(0,1fr);gap:4px 14px;width:100%;padding:14px 14px 14px 12px;text-align:left;background:#fffdf9;border:1px solid #e5dccd;border-radius:16px;color:#392317;cursor:pointer;transition:border-color .15s,box-shadow .15s}.ds-row:hover{border-color:#d6c8b3;box-shadow:0 1px 2px rgba(57,35,23,.06),0 8px 24px rgba(57,35,23,.06)}.ds-row-when{display:grid;align-content:start;gap:2px}.ds-row-when strong{font:400 22px/1 Gloock,Georgia,serif;font-variant-numeric:tabular-nums}.ds-row-when span{font-size:12px;color:#6b5c4c}.ds-row-main{display:grid;gap:4px;min-width:0}.ds-row-name{font:400 1.2rem/1.2 Gloock,Georgia,serif;overflow-wrap:anywhere}.ds-row-items{font-size:14px;color:#6b5c4c;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}"
