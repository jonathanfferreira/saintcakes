      "kind": "custom",
      "refersTo": "box-bar",
      "description": "Caixa fixa no rodapé do celular: miniaturas, contagem, total e Fechar pedido. Vira coluna sticky no desktop.",
      "html": "<aside class=\"ds-box\"><div class=\"ds-box-text\"><strong>Sua caixa · 3 itens</strong><span>Total estimado</span></div><button class=\"ds-btn-on-dark\">Fechar pedido</button></aside>",
      "css": ".ds-box{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:#392317;color:#faf7f0;box-shadow:0 -6px 24px rgba(57,35,23,.18)}.ds-box-text{display:grid;gap:2px;min-width:0;line-height:1.25}.ds-box-text strong{font:600 15px/1.25 'Onest Variable',system-ui,sans-serif;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-box-text span{font-size:13px;color:#e6d9c3}.ds-btn-on-dark{flex:none;min-height:48px;padding:0 18px;border:0;border-radius:999px;background:#f0d9a8;color:#392317;font:600 15px/1 'Onest Variable',system-ui,sans-serif;cursor:pointer}.ds-btn-on-dark:focus-visible{outline:3px solid #f0d9a8;outline-offset:3px}"
    },
    {
      "name": "Photo Card",
      "kind": "card",
      "refersTo": "card-photo",
