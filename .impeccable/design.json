      "css": ".ds-comanda{display:grid;gap:10px;padding:0 20px 20px;background:#fffdf9;border:1px solid #e5dccd;border-radius:16px;box-shadow:0 1px 2px rgba(57,35,23,.06),0 8px 24px rgba(57,35,23,.06);overflow:hidden}.ds-comanda-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:0 -20px;padding:14px 20px 12px;background:#ece4f2}.ds-comanda-time{font:400 2rem/1 Gloock,Georgia,serif}.ds-comanda h3{margin:0;font:400 22px/1.2 Gloock,Georgia,serif;overflow-wrap:anywhere}.ds-comanda ul{display:grid;gap:8px;margin:4px 0 0;padding:12px 0 0;list-style:none;border-top:1px dashed #d6c8b3}.ds-comanda li{font-size:17px;line-height:1.35}.ds-comanda li strong{font-weight:700}"
