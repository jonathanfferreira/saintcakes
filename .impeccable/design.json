      "description": "Ação principal. Pílula chocolate; 48px na página pública, 44px mínimo no app.",
      "html": "<button class=\"ds-btn-primary\">Fechar pedido</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border:0;border-radius:999px;background:#392317;color:#faf7f0;font:600 15px/1 'Onest Variable',system-ui,sans-serif;white-space:nowrap;cursor:pointer;transition:background-color .2s cubic-bezier(.2,.8,.2,1)}.ds-btn-primary:hover:not(:disabled){background:#4f3322}.ds-btn-primary:disabled{background:#d9cfbf;color:#5f5242;cursor:not-allowed}.ds-btn-primary:focus-visible{outline:3px solid #936326;outline-offset:3px}.ds-btn-primary:active:not(:disabled){transform:scale(.97)}"
